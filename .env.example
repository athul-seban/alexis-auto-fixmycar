# App
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-here-generate-with-openssl-rand-base64-32
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=QuoteMyGarage

# Database (AWS RDS PostgreSQL)
DATABASE_URL="postgresql://username:password@your-rds-endpoint.ap-southeast-1.rds.amazonaws.com:5432/quotemygarage"

# AWS
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET=quotemygarage-assets

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (AWS SES)
EMAIL_SERVER_HOST=email-smtp.ap-southeast-1.amazonaws.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=your-ses-smtp-user
EMAIL_SERVER_PASSWORD=your-ses-smtp-password
EMAIL_FROM=noreply@quotemygarage.com

# Google Maps (for location search)
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# Vehicle Lookup API (DVLA/VAPI)
VEHICLE_LOOKUP_API_KEY=

# Vercel Blob (garage logo/photo uploads)
BLOB_READ_WRITE_TOKEN=

# Cron (protects /api/cron/* routes from public invocation)
CRON_SECRET=your-random-secret-here

# Number of trusted reverse proxies in front of the app (e.g. 2 for CloudFront -> App Runner). Used to
# pick the real client IP from X-Forwarded-For so the widget's per-IP limit can't be spoofed. Not needed on Vercel.
TRUSTED_PROXY_HOPS=

# Salt for hashing visitor IPs (booking-widget abuse limiting). Falls back to NEXTAUTH_SECRET if unset.
IP_HASH_SECRET=your-random-secret-here

# Stripe (online deposits on the booking widget). Leave unset to run without payments: the toggle is disabled and
# bookings are made with no deposit. The webhook endpoint is POST /api/stripe/webhook (events: checkout.session.completed,
# checkout.session.expired, checkout.session.async_payment_succeeded, checkout.session.async_payment_failed).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# SMS (Twilio) for booking reminders and updates. Leave unset to run without texting: the garage switch is disabled and
# nothing is sent. Use either a sending number (TWILIO_FROM, E.164) or a Messaging Service SID.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=

# Stripe Connect: deposits are paid straight to each garage's own connected account.
# Optional platform commission taken from each deposit (0-30, default 0 = none).
PLATFORM_FEE_PERCENT=
# Second signing secret: the webhook endpoint that listens to events on connected accounts (account.updated).
STRIPE_CONNECT_WEBHOOK_SECRET=

# --- Phase 3 ---
# Garage plans (Stripe Billing). Create a recurring Price in Stripe for each paid plan in src/lib/portal/plans.ts and put
# its id here. Plan limits and feature gates stay OFF until PLANS_ENFORCED=true, so set that last, once plan names,
# prices and limits are agreed. The webhook endpoint (POST /api/stripe/webhook) must also receive:
# customer.subscription.created, customer.subscription.updated, customer.subscription.deleted
# (checkout.session.completed is already needed: it grants lead credits and featured placement).
STRIPE_PRICE_PRO=
STRIPE_PRICE_PREMIUM=
PLANS_ENFORCED=

# Web Push (installable app notifications). Generate a pair with: npx web-push generate-vapid-keys
# The public key is sent to browsers, so it needs the NEXT_PUBLIC_ prefix. Unset = push is off, nothing breaks.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@quotemygarage.com

# DVSA MOT history lookup (look a vehicle up by registration). Credentials are issued by DVSA after you apply at
# https://documentation.history.mot.api.gov.uk/mot-history-api/register . Unset = the "Look up vehicle" button is hidden.
# DVSA_TOKEN_URL is the full Microsoft token URL from DVSA's email (it contains your tenant id).
DVSA_CLIENT_ID=
DVSA_CLIENT_SECRET=
DVSA_TOKEN_URL=
DVSA_API_KEY=
# Optional override of the lookup base URL (default https://history.mot.api.gov.uk/v1/trade/vehicles/registration).
DVSA_MOT_BASE_URL=
