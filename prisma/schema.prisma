generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  phone         String?
  role          String    @default("OWNER")
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  suspendedAt   DateTime?
  smsOptIn      Boolean   @default(false) // texts about their bookings (customers)
  emailNotifications Boolean @default(true)  // booking / quote / message emails
  marketingOptIn     Boolean @default(false) // tips and offers
  sessionVersion     Int     @default(0)     // bump to sign the user out everywhere
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  vehicles Vehicle[]
  quotes   Quote[]   @relation("OwnerQuotes")
  bookings Booking[] @relation("OwnerBookings")
  reviews  Review[]  @relation("OwnerReviews")
  garage   Garage?
  messages      Message[]
  notifications Notification[]
  pushSubscriptions PushSubscription[]
  articles      Article[]
  memberships   Membership[]
  technicianProfiles Technician[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Vehicle {
  id           String    @id @default(cuid())
  ownerId      String
  registration String
  make         String
  model        String
  year         Int
  fuel         String?
  color        String?
  mileage      Int?
  motDueDate   DateTime?
  serviceDueDate DateTime?
  motHistory   String?   // JSON from the DVSA MOT history API (cached)
  motHistoryAt DateTime?
  // Reminder bookkeeping: the due date and stage (days-before threshold) last reminded, so each stage sends once.
  motReminderFor DateTime?
  motReminderStage Int?
  serviceReminderFor DateTime?
  serviceReminderStage Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  owner    User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  quotes   Quote[]
  bookings Booking[]

  @@index([ownerId])
}

model Garage {
  id                 String    @id @default(cuid())
  userId             String?   @unique // the login a single-owner garage was registered with; locations added later have none (access comes from Membership)
  organisationId     String?   // the business this location belongs to; null until backfilled
  name               String
  slug               String    @unique
  description        String?
  logo               String?
  images             String    @default("[]")
  phone              String
  email              String
  vatNumber          String?   // UK VAT registration, e.g. GB123456789; null when not VAT registered
  website            String?
  address            String
  city               String
  postcode           String
  latitude           Float?
  longitude          Float?
  status             String    @default("PENDING")
  isVerified         Boolean   @default(false)
  verificationBadges String    @default("[]")
  isMobile           Boolean   @default(false)
  services           String    @default("[]")
  openingHours       String?
  totalReviews       Int       @default(0)
  averageRating      Float     @default(0)
  totalBookings      Int       @default(0)
  // JSON string validated by src/lib/portal/portal-settings.ts (widget config, notification prefs)
  portalSettings     String?
  // Last invoice number issued (INV-0001...). Incremented atomically when an invoice is first generated.
  invoiceCounter     Int       @default(0)
  // Stripe Connect (Express): deposits are paid straight to this account, minus the platform fee.
  stripeAccountId       String?   @unique
  stripeChargesEnabled  Boolean   @default(false) // the garage finished onboarding and can take card payments
  // Phase 3: subscription plan (Stripe Billing), paid promotion, pay-per-lead balance, ranking inputs.
  plan                  String    @default("FREE") // FREE | PRO | PREMIUM (see src/lib/portal/plans.ts)
  stripeCustomerId      String?   @unique
  stripeSubscriptionId  String?   @unique
  subscriptionStatus    String?   // Stripe's status: active | trialing | past_due | canceled ...
  subscriptionPeriodEnd DateTime?
  featuredUntil         DateTime? // paid "Featured" placement runs until this moment
  leadCredits           Int       @default(0)
  avgResponseMins       Float?    // running average time to answer a job request
  responseSamples       Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull) // deleting a person never deletes a location
  organisation Organisation? @relation(fields: [organisationId], references: [id], onDelete: Restrict) // a business can never cascade away
  quotes       Quote[]
  bookings     Booking[]
  reviews      Review[]
  jobResponses JobResponse[]
  messages     Message[]
  notifications Notification[]
  technicians   Technician[]
  servicePrices ServicePrice[]
  diaryBlocks   DiaryBlock[]
  leads         GarageLead[]
  customerNotes CustomerNote[]
  customerMerges CustomerMerge[]
  pushSubscriptions PushSubscription[]
  creditTransactions LeadCreditTransaction[]
  documents     GarageDocument[]
  roleAssignments RoleAssignment[]

  @@index([organisationId])
}

model Quote {
  id          String   @id @default(cuid())
  ownerId     String
  vehicleId   String
  garageId    String
  serviceType String
  description String
  status      String   @default("PENDING")
  price       Float?
  laborCost   Float?
  partsCost   Float?
  notes       String?
  validUntil  DateTime?
  contactedAt DateTime?
  services    String    @default("[]")  // JSON array of every work requested (serviceType is the first)
  respondBy   DateTime?                 // garage's deadline to quote
  source      String    @default("MANUAL") // MANUAL | AUTO | ESTIMATE: how the price was produced
  lineItems   String?                   // JSON [{ serviceType, price, source }]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner   User    @relation("OwnerQuotes", fields: [ownerId], references: [id])
  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
  garage  Garage  @relation(fields: [garageId], references: [id])
  booking Booking?

  @@index([garageId, status])
  @@index([ownerId])
}

model Booking {
  id          String    @id @default(cuid())
  // Null for walk-in / phone / widget bookings made without an owner account.
  // Invariant (enforced in booking-service): ownerId != null => vehicleId != null.
  ownerId     String?
  vehicleId   String?
  garageId    String
  quoteId     String?   @unique
  serviceType String
  description String?
  // PENDING | CONFIRMED | IN_PROGRESS | COMPLETED | CANCELLED | NO_SHOW
  status      String    @default("PENDING")
  scheduledAt DateTime
  completedAt DateTime?
  totalPrice  Float
  lineItems   String?   // JSON [{ serviceType, price, source }] when the booking covers several works
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  jobResponseId String?     @unique

  // Garage-portal fields. Customer/vehicle snapshots let the portal read walk-in bookings
  // without ever joining owner/vehicle.
  reference         String?   @unique // QMG-XXXXXX
  source            String    @default("MARKETPLACE") // MARKETPLACE | QUOTE | JOB_REQUEST | WIDGET | DIRECT
  customerName      String?
  customerEmail     String?
  customerPhone     String?
  vrm               String?   // normalised: upper-case, no spaces
  vehicleMake       String?
  vehicleModel      String?
  vehicleYear       Int?
  technicianId      String?
  durationMins      Int?
  contactedAt       DateTime?
  notes             String?   // garage-internal; `description` stays customer-supplied
  finalInvoiceValue Float?
  cancelReason      String?
  searchText        String?   // lower-cased concat so search behaves the same on SQLite and Postgres
  ipHash            String?   // widget abuse limiting
  timeConfirmed     Boolean   @default(true) // false when created from a quote/job without an explicit time
  manageToken       String?   @unique // secret in the customer's email link: view / cancel / review without an account
  // Online deposit (Stripe Checkout). NONE = no online payment; PENDING = checkout started; PAID; REFUNDED; FAILED.
  paymentStatus        String    @default("NONE")
  depositAmount        Float?    // GBP charged online
  refundedAmount       Float?
  stripeSessionId      String?   @unique
  stripePaymentIntent  String?
  // Text messages: the customer ticked "text me" (or has it on in their account) and when the 24h text went out.
  smsOptIn          Boolean   @default(false)
  smsReminderSentAt DateTime?
  invoiceNumber     String?   // assigned the first time an invoice is generated, then fixed
  invoicedAt        DateTime?
  reminderSentAt    DateTime? // set once the 24h-before reminder email has gone out
  reviewRequestedAt DateTime? // set once the "how did we do?" email has gone out
  marketingOptIn    Boolean   @default(false) // ticked "email me reminders and offers from this garage"

  owner       User?       @relation("OwnerBookings", fields: [ownerId], references: [id], onDelete: Restrict)
  vehicle     Vehicle?    @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  garage      Garage      @relation(fields: [garageId], references: [id])
  quote       Quote?      @relation(fields: [quoteId], references: [id])
  jobResponse JobResponse? @relation(fields: [jobResponseId], references: [id])
  technician  Technician? @relation(fields: [technicianId], references: [id], onDelete: SetNull)
  review      Review?
  events      BookingEvent[]

  @@index([ownerId])
  @@index([createdAt])
  @@index([garageId, scheduledAt])
  @@index([garageId, createdAt])
  @@index([garageId, status])
  @@index([garageId, source])
  @@index([customerEmail])
  @@unique([garageId, invoiceNumber])
}

model Review {
  id        String   @id @default(cuid())
  // Null when a customer without an account reviews via their booking's manage link.
  ownerId      String?
  customerName String? // name snapshot, used when there is no owner account
  garageId  String
  bookingId String   @unique
  rating    Int
  title     String?
  comment   String
  reply     String?
  repliedAt DateTime?
  // A garage can dispute a review; an admin then upholds (review removed) or rejects the dispute.
  disputedAt     DateTime?
  disputeReason  String?
  disputeStatus  String? // OPEN | UPHELD | REJECTED
  disputeNote    String? // admin's decision note
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner   User?   @relation("OwnerReviews", fields: [ownerId], references: [id])
  garage  Garage  @relation(fields: [garageId], references: [id])
  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([garageId, createdAt])
}

// Append-only history of what happened to a booking (shown as the timeline in the garage portal).
model BookingEvent {
  id        String   @id @default(cuid())
  bookingId String
  actorType String // GARAGE | OWNER | CUSTOMER | ADMIN | SYSTEM
  actorName String?
  type      String // CREATED | STATUS | RESCHEDULED | TECHNICIAN | CONTACTED | NOTE | REMINDER | REVIEW
  detail    String?
  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
}

model JobRequest {
  id     String @id @default(cuid())
  token  String @unique
  status String @default("OPEN") // OPEN | QUOTED | BOOKED | CANCELLED | EXPIRED

  guestName  String
  guestEmail String
  guestPhone String

  registration String
  make         String
  model        String
  year         Int
  fuel         String?
  mileage      Int?

  serviceType       String
  description       String
  city              String
  postcode          String
  isMobilePreferred Boolean   @default(false)
  preferredDate     DateTime?

  // Set when the customer asked one specific garage for a quote (from its profile); null = sent to every matching garage.
  targetGarageId String?

  // Every work requested (JSON array of service codes; serviceType is the first). respondBy is the garage's deadline
  // to quote; after it the request expires or falls back to an estimate (garage setting).
  services  String    @default("[]")
  respondBy DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  responses JobResponse[]
  leads     GarageLead[]

  @@index([targetGarageId])
}

model JobResponse {
  id           String    @id @default(cuid())
  jobRequestId String
  garageId     String
  price        Float
  laborCost    Float?
  partsCost    Float?
  message      String?
  status       String    @default("SENT") // SENT | ACCEPTED | DECLINED
  validUntil   DateTime?
  source       String    @default("MANUAL") // MANUAL | AUTO | ESTIMATE: how the price was produced
  lineItems    String?   // JSON [{ serviceType, price, source }]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  jobRequest JobRequest @relation(fields: [jobRequestId], references: [id], onDelete: Cascade)
  garage     Garage     @relation(fields: [garageId], references: [id])
  booking    Booking?

  @@unique([jobRequestId, garageId])
}

model Message {
  id          String   @id @default(cuid())
  quoteId     String?
  bookingId   String?
  senderId    String
  garageId    String
  body        String
  readAt      DateTime?
  fromGarage  Boolean  @default(false) // sent from the garage side (any staff member); recorded when written
  createdAt   DateTime @default(now())

  sender User   @relation(fields: [senderId], references: [id], onDelete: Cascade)
  garage Garage @relation(fields: [garageId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@index([bookingId])
  @@index([garageId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String?
  garageId  String?
  type      String
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  garage Garage? @relation(fields: [garageId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([garageId])
}

model Technician {
  id        String   @id @default(cuid())
  garageId  String
  name      String
  email     String?
  phone     String?
  color     String   @default("#1E3A5F")
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  userId    String?  // the login of a technician who signs in and sees only their own jobs
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  garage      Garage       @relation(fields: [garageId], references: [id], onDelete: Cascade)
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  bookings    Booking[]
  diaryBlocks DiaryBlock[]

  @@unique([garageId, userId])
  @@index([garageId])
  @@index([userId])
}

model ServicePrice {
  id           String   @id @default(cuid())
  garageId     String
  serviceType  String
  priceFrom    Float?
  priceTo      Float?
  durationMins Int      @default(60)
  notes        String?
  isActive     Boolean  @default(true)
  // A fixed price the garage commits to. With autoQuote on, a request for this work is answered instantly at this price.
  fixedPrice   Float?
  autoQuote    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  garage Garage @relation(fields: [garageId], references: [id], onDelete: Cascade)

  @@unique([garageId, serviceType])
}

// Time off / closures. A null technician blocks the whole garage.
model DiaryBlock {
  id           String   @id @default(cuid())
  garageId     String
  technicianId String?
  startAt      DateTime
  endAt        DateTime
  allDay       Boolean  @default(false)
  reason       String?
  createdAt    DateTime @default(now())

  garage     Garage      @relation(fields: [garageId], references: [id], onDelete: Cascade)
  technician Technician? @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  @@index([garageId, startAt])
}

// Per-garage state for a guest job lead. Rows are created lazily, only after a garage
// acts on a lead (so "new" simply means no row).
model GarageLead {
  id           String    @id @default(cuid())
  garageId     String
  jobRequestId String
  status       String    @default("IGNORED") // IGNORED | CONTACTED
  contactedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  garage     Garage     @relation(fields: [garageId], references: [id], onDelete: Cascade)
  jobRequest JobRequest @relation(fields: [jobRequestId], references: [id], onDelete: Cascade)

  @@unique([garageId, jobRequestId])
}

// One row per counted attempt (login, password reset, public form posts...). A limit is "N rows with this key in the
// last W ms", so it works across instances without in-memory state. Old rows are pruned opportunistically.
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
  @@index([createdAt])
}

// Who did what in the admin portal (approvals, suspensions, role changes, deletions). Append-only.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String?
  action     String // GARAGE_APPROVED | GARAGE_SUSPENDED | GARAGE_BADGES | USER_ROLE | USER_SUSPENDED | USER_DELETED | USER_RESET | REVIEW_DELETED
  targetType String // GARAGE | USER | REVIEW
  targetId   String
  detail     String?
  organisationId String? // set for actions inside a garage business, so it can see its own trail
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
  @@index([organisationId, createdAt])
}

// Stripe webhook events already handled, so a redelivered event is a no-op (webhooks are at-least-once).
model StripeEvent {
  id        String   @id // Stripe's event id
  type      String
  createdAt DateTime @default(now())
}

// A garage's private note about a customer. Customers are derived from bookings (no Customer table), so a note is
// keyed by the same normalised identity the CRM groups on (see src/lib/portal/customers.ts).
model CustomerNote {
  id          String   @id @default(cuid())
  garageId    String
  customerKey String
  body        String
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  garage Garage @relation(fields: [garageId], references: [id], onDelete: Cascade)

  @@unique([garageId, customerKey])
}

// "These two customers are the same person": the garage merged one derived identity (fromKey) into another (toKey).
// Customers are derived from bookings, so a merge is just a redirect applied when grouping (see customers.ts).
model CustomerMerge {
  id        String   @id @default(cuid())
  garageId  String
  fromKey   String
  toKey     String
  createdAt DateTime @default(now())

  garage Garage @relation(fields: [garageId], references: [id], onDelete: Cascade)

  @@unique([garageId, fromKey])
  @@index([garageId])
}

// A browser/device that agreed to push notifications (Web Push). Belongs to a user or a garage.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String?
  garageId  String?
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  garage Garage? @relation(fields: [garageId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([garageId])
}

// Every change to a garage's pay-per-lead balance. The balance on Garage is the sum of these.
model LeadCreditTransaction {
  id              String   @id @default(cuid())
  garageId        String
  delta           Int      // + purchase / grant, - a lead answered
  reason          String   // PURCHASE | LEAD | GRANT | REFUND
  jobRequestId    String?
  stripeSessionId String?  @unique
  organisationId  String?  // the business whose balance this moved (garageId = the location that answered)
  createdAt       DateTime @default(now())

  garage Garage @relation(fields: [garageId], references: [id], onDelete: Cascade)

  @@index([garageId, createdAt])
  @@index([organisationId, createdAt])
}

// Verification paperwork a garage uploads (insurance, trade certificates...) for an admin to review.
model GarageDocument {
  id         String    @id @default(cuid())
  garageId   String
  kind       String    // INSURANCE | TRADE_CERTIFICATE | ID | OTHER
  name       String
  url        String
  status     String    @default("PENDING") // PENDING | APPROVED | REJECTED
  note       String?   // admin's reason when rejected
  reviewedAt DateTime?
  createdAt  DateTime  @default(now())

  garage Garage @relation(fields: [garageId], references: [id], onDelete: Cascade)

  @@index([garageId, status])
  @@index([status])
}

// Guides and blog posts. `body` is a small Markdown subset (see src/lib/articles.ts).
model Article {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  excerpt         String?
  body            String
  coverImage      String?
  status          String    @default("DRAFT") // DRAFT | PUBLISHED
  metaTitle       String?
  metaDescription String?
  authorId        String?
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([status, publishedAt])
}

// Admin-editable site content (marketing copy, footer, notice, legal pages, email wording). The defaults live in code
// (src/lib/i18n/messages); a row here overrides one key for one language. `draft` is saved but not live until published.
model ContentEntry {
  id          String   @id @default(cuid())
  key         String
  locale      String
  value       String   @default("") // live override; empty = use the built-in default
  draft       String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([key, locale])
}

// Platform-wide secrets a super admin pastes in at /admin/settings (DVSA MOT history, DVLA). `value` is AES-256-GCM
// encrypted (src/lib/platform-settings.ts) and never sent back to the browser. A saved value overrides the env var.
model PlatformSetting {
  key         String   @id
  value       String
  updatedById String?
  updatedAt   DateTime @updatedAt
}

// ---- Garage businesses, locations, staff and roles ----------------------------------------------------------------
// A BUSINESS (Organisation) owns one or more LOCATIONS (Garage rows: every child table still keys on garageId), its
// staff (Membership), its roles and the billing relationship. Access is decided by Membership + RoleAssignment; the
// legacy Garage.userId login keeps working for garages with organisationId = null (not yet backfilled).
model Organisation {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique // internal handle; the website subdomain lives on OrganisationSite
  legalName    String?
  vatNumber    String?
  logo         String?
  description  String?
  website      String?
  contactEmail String?
  contactPhone String?
  // Billing belongs to the business. While a business has a single location these are mirrored onto its Garage row,
  // so an older build still sees the same values (see src/lib/org/billing.ts).
  plan                  String    @default("FREE") // FREE | PRO | PREMIUM (src/lib/portal/plans.ts)
  stripeCustomerId      String?   @unique
  stripeSubscriptionId  String?   @unique
  subscriptionStatus    String?
  subscriptionPeriodEnd DateTime?
  leadCredits           Int       @default(0)
  stripeAccountId       String?   @unique
  stripeChargesEnabled  Boolean   @default(false)
  invoiceCounter        Int       @default(0)
  suspendedAt           DateTime? // admin kill switch for the whole business
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  locations   Garage[]
  roles       Role[]
  memberships Membership[]
  invites     StaffInvite[]
  site        OrganisationSite?
}

// A named set of permissions inside one business. System roles (owner, manager, staff) are created with the business;
// presets (src/lib/org/presets.ts) are copied in when a garage admin enables them; custom roles have no presetKey.
model Role {
  id             String    @id @default(cuid())
  organisationId String
  presetKey      String? // owner | manager | staff | a preset key; null for a custom role
  name           String
  description    String?
  permissions    String    @default("[]") // JSON array of permission keys (src/lib/org/permissions.ts)
  isSystem       Boolean   @default(false) // owner / manager / staff: can be edited (not owner) but never deleted or disabled
  isEnabled      Boolean   @default(true) // a disabled role can't be assigned
  presetVersion  Int       @default(0) // the preset version this role was copied from, to offer "update available"
  editedAt       DateTime? // set when a garage admin changes a preset's permissions, so it is never auto-synced
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organisation Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  assignments  RoleAssignment[]

  @@unique([organisationId, presetKey]) // NULLs are distinct: any number of custom roles, each preset at most once
  @@index([organisationId])
}

// "This person works for this business." What they may do comes from their RoleAssignments.
model Membership {
  id             String   @id @default(cuid())
  userId         String
  organisationId String
  status         String   @default("ACTIVE") // ACTIVE | SUSPENDED
  invitedById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  assignments  RoleAssignment[]

  @@unique([userId, organisationId])
  @@index([organisationId])
}

// A role held at one location, or at all of them. scopeKey is the garageId, or "*" for all locations (including ones
// added later). It is never null, so the unique key below is airtight (a nullable garageId would allow duplicates).
model RoleAssignment {
  id           String   @id @default(cuid())
  membershipId String
  roleId       String
  garageId     String?
  scopeKey     String
  createdAt    DateTime @default(now())

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict) // a role in use can't be deleted
  garage     Garage?    @relation(fields: [garageId], references: [id], onDelete: Cascade)

  @@unique([membershipId, roleId, scopeKey])
  @@index([roleId])
  @@index([garageId])
}

// An emailed invitation to join a business as staff. Only the sha-256 of the token is stored.
model StaffInvite {
  id             String    @id @default(cuid())
  organisationId String
  email          String
  assignments    String    @default("[]") // JSON: [{ roleId, garageIds: string[] | null }] (null = all locations)
  tokenHash      String    @unique
  invitedById    String?
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId, email])
}

// A business's one-page website (shown on its own subdomain). `content` / `theme` are what visitors see; edits go to the
// draft copies and are copied across on publish. Validated by src/lib/site/*; never trusted as HTML.
model OrganisationSite {
  id              String    @id @default(cuid())
  organisationId  String    @unique
  status          String    @default("DRAFT") // DRAFT | PENDING_REVIEW | PUBLISHED | UNPUBLISHED | REJECTED
  theme           String    @default("{}") // JSON, the published theme
  content         String    @default("{}") // JSON, the published content
  draftTheme      String? // JSON edits not yet published (null = same as published)
  draftContent    String?
  logo            String? // our own storage URL under orgs/<organisationId>/
  version         Int       @default(1) // bumped on every save; a stale editor is refused instead of overwriting
  submittedAt     DateTime? // when the first publish was requested
  approvedAt      DateTime? // a platform admin approved the first publish (later edits publish freely)
  approvedById    String?
  rejectedAt      DateTime?
  rejectionReason String?
  publishedAt     DateTime?
  disabledAt      DateTime? // platform kill switch: takes the site down whatever its status
  disabledReason  String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organisation Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  domains      SiteDomain[]
  revisions    SiteRevision[]
}

// An address a site answers on. Today only subdomains (host = the label, e.g. "acme" for acme.<root domain>); `kind`
// leaves room for custom domains. A label is never deleted or reused: when a site changes label the old one becomes a
// REDIRECT to the new, so links keep working and nobody else can claim it.
model SiteDomain {
  id        String   @id @default(cuid())
  siteId    String
  host      String   @unique
  kind      String   @default("SUBDOMAIN") // SUBDOMAIN | CUSTOM
  status    String   @default("ACTIVE") // ACTIVE | REDIRECT
  createdAt DateTime @default(now())

  site OrganisationSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
}

// A saved copy of what was published (the last 20 are kept) so a bad edit can be rolled back.
model SiteRevision {
  id          String   @id @default(cuid())
  siteId      String
  version     Int
  theme       String
  content     String
  createdById String?
  note        String?
  createdAt   DateTime @default(now())

  site OrganisationSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, createdAt])
}

// Addresses that must not get marketing-type email (review requests, reminders, offers). scope = "ALL" or a garage id.
model EmailSuppression {
  id        String   @id @default(cuid())
  email     String
  scope     String   @default("ALL")
  reason    String   @default("UNSUBSCRIBED")
  createdAt DateTime @default(now())

  @@unique([email, scope])
  @@index([email])
}
