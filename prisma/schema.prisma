generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  phone         String?
  role          String    @default("OWNER")
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  vehicles Vehicle[]
  quotes   Quote[]   @relation("OwnerQuotes")
  bookings Booking[] @relation("OwnerBookings")
  reviews  Review[]  @relation("OwnerReviews")
  garage   Garage?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Vehicle {
  id           String   @id @default(cuid())
  ownerId      String
  registration String
  make         String
  model        String
  year         Int
  fuel         String?
  color        String?
  mileage      Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  owner    User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  quotes   Quote[]
  bookings Booking[]
}

model Garage {
  id            String   @id @default(cuid())
  userId        String   @unique
  name          String
  slug          String   @unique
  description   String?
  logo          String?
  images        String   @default("[]")
  phone         String
  email         String
  website       String?
  address       String
  city          String
  postcode      String
  latitude      Float?
  longitude     Float?
  status        String   @default("PENDING")
  isVerified    Boolean  @default(false)
  isMobile      Boolean  @default(false)
  services      String   @default("[]")
  openingHours  String?
  totalReviews  Int      @default(0)
  averageRating Float    @default(0)
  totalBookings Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  quotes       Quote[]
  bookings     Booking[]
  reviews      Review[]
  jobResponses JobResponse[]
}

model Quote {
  id          String   @id @default(cuid())
  ownerId     String
  vehicleId   String
  garageId    String
  serviceType String
  description String
  status      String   @default("PENDING")
  price       Float?
  laborCost   Float?
  partsCost   Float?
  notes       String?
  validUntil  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner   User    @relation("OwnerQuotes", fields: [ownerId], references: [id])
  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
  garage  Garage  @relation(fields: [garageId], references: [id])
  booking Booking?
}

model Booking {
  id          String    @id @default(cuid())
  ownerId     String
  vehicleId   String
  garageId    String
  quoteId     String?   @unique
  serviceType String
  description String?
  status      String    @default("PENDING")
  scheduledAt DateTime
  completedAt DateTime?
  totalPrice  Float
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  jobResponseId String?     @unique

  owner       User        @relation("OwnerBookings", fields: [ownerId], references: [id])
  vehicle     Vehicle     @relation(fields: [vehicleId], references: [id])
  garage      Garage      @relation(fields: [garageId], references: [id])
  quote       Quote?      @relation(fields: [quoteId], references: [id])
  jobResponse JobResponse? @relation(fields: [jobResponseId], references: [id])
  review      Review?
}

model Review {
  id        String   @id @default(cuid())
  ownerId   String
  garageId  String
  bookingId String   @unique
  rating    Int
  title     String?
  comment   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner   User    @relation("OwnerReviews", fields: [ownerId], references: [id])
  garage  Garage  @relation(fields: [garageId], references: [id])
  booking Booking @relation(fields: [bookingId], references: [id])
}

model JobRequest {
  id     String @id @default(cuid())
  token  String @unique
  status String @default("OPEN") // OPEN | QUOTED | BOOKED | CANCELLED

  guestName  String
  guestEmail String
  guestPhone String

  registration String
  make         String
  model        String
  year         Int
  fuel         String?
  mileage      Int?

  serviceType       String
  description       String
  city              String
  postcode          String
  isMobilePreferred Boolean   @default(false)
  preferredDate     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  responses JobResponse[]
}

model JobResponse {
  id           String    @id @default(cuid())
  jobRequestId String
  garageId     String
  price        Float
  laborCost    Float?
  partsCost    Float?
  message      String?
  status       String    @default("SENT") // SENT | ACCEPTED | DECLINED
  validUntil   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  jobRequest JobRequest @relation(fields: [jobRequestId], references: [id], onDelete: Cascade)
  garage     Garage     @relation(fields: [garageId], references: [id])
  booking    Booking?

  @@unique([jobRequestId, garageId])
}
